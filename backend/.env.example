DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/growth_diary
JWT_SECRET=change-this-to-a-random-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-120b
# 로컬 테스트용 /api/debug 엔드포인트 (운영에서는 false)
ENABLE_DEBUG_API=false

# AI 호출 방식: groq(배포 기본) | claude_code(로컬 전용, 이 PC에 로그인된 claude CLI 사용)
LLM_PROVIDER=groq
CLAUDE_CODE_MODEL=sonnet

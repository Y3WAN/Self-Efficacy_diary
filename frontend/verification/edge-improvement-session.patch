@@ -0,0 +1,121 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { createMallangMaterial, materialContact, membraneRadii, membraneRadiusAt } from "../src/utils/mallangMaterial.js";
+import { pulledCircle } from "../src/utils/mallangMotion.js";
+import { createWaxShell } from "../src/utils/waxShell.js";
+
+function run(material, from, to, step = 16) {
+  for (let now = from + step; now <= to; now += step) material.advance(now);
+}
+
+test("a deep rim contact indents locally with raised shoulders on both sides", () => {
+  for (const angle of [0, Math.PI / 2, Math.PI, Math.PI * 1.5]) {
+    const material = createMallangMaterial();
+    material.touch(100 + Math.cos(angle) * 90, 100 + Math.sin(angle) * 90, 0);
+    run(material, 0, 2400);
+    const radii = membraneRadii(material), index = Math.round(angle / (2 * Math.PI) * radii.length);
+    assert(radii[index] < 92, "negative height must indent, not inflate the contact");
+    assert(radii[(index + 8) % radii.length] > 94.5, "first shoulder must carry displaced contents");
+    assert(radii[(index + radii.length - 8) % radii.length] > 94.5, "second shoulder must carry displaced contents");
+  }
+});
+
+test("slow deep holds retain pressure while approaching and following the rim", () => {
+  const material = createMallangMaterial();
+  material.touch(100, 100, 0); run(material, 0, 1200);
+  let now = 1200;
+  for (let distance = 0.4; distance <= 90; distance += 0.4) {
+    now += 16; material.move(100 + distance, 100, now); material.advance(now);
+    if (distance > 84) assert(material.contactDepth() > 0.9, "slow rim contact lost sustained pressure");
+  }
+  for (let frame = 1; frame <= 150; frame++) {
+    now += 16;
+    const angle = Math.sin(frame / 55) * 0.65;
+    material.move(100 + Math.cos(angle) * 90, 100 + Math.sin(angle) * 90, now);
+    material.advance(now);
+    assert(material.contactDepth() > 0.88);
+    assert(Math.abs(material.state.signedHeight) < 0.05);
+  }
+  const before = membraneRadii(material);
+  run(material, now, now + 5000); const settled = membraneRadii(material);
+  run(material, now + 5000, now + 12000);
+  assert.equal(material.state.active, false);
+  assert(Math.max(...settled.map((r, i) => Math.abs(r - membraneRadii(material)[i]))) < 0.02);
+  assert(Math.max(...before.map((r, i) => Math.abs(r - settled[i]))) < 10);
+  material.release(now + 12000); run(material, now + 12000, now + 18000);
+  assert.equal(material.state.active, false);
+  assert(membraneRadii(material).every(r => r === 94));
+});
+
+test("fast rubbing cannot paint a sustained deep trench near the rim", () => {
+  const material = createMallangMaterial();
+  material.touch(100, 100, 0); run(material, 0, 1200);
+  material.move(189, 100, 1216); material.advance(1216);
+  assert(material.contactDepth() < 0.35);
+  for (let frame = 1; frame <= 60; frame++) {
+    const angle = frame * 0.09, now = 1216 + frame * 16;
+    material.move(100 + Math.cos(angle) * 88, 100 + Math.sin(angle) * 88, now); material.advance(now);
+    assert(material.contactDepth() < 0.5);
+  }
+  material.release(2176, false); run(material, 2176, 5000);
+  assert.equal(material.state.active, false);
+});
+
+test("contact follows the deformed contour continuously and hands pressure over to the pull", () => {
+  const material = createMallangMaterial();
+  const motion = { rect: { left: 0, top: 0, width: 800, height: 600 }, bodySize: 200,
+    position: { x: 50, y: 50 }, pointer: { x: 400, y: 300 } };
+  material.touch(100, 100, 0); run(material, 0, 1200);
+  let now = 1200, previous = membraneRadii(material), lastContact = { x: 100, y: 100 };
+  for (const direction of [1, -1]) {
+    for (let i = 0; i <= 480; i++) {
+      const distance = direction === 1 ? i / 4 : 120 - i / 4;
+      const raw = { x: 100 + distance, y: 100 };
+      const boundary = materialContact(material, raw);
+      motion.pointer.x = 400 + distance;
+      const pull = pulledCircle(motion, boundary.radius), contact = materialContact(material, raw, pull);
+      now += 16; material.move(contact.x, contact.y, now, contact.pressure); material.advance(now);
+      const radii = membraneRadii(material, pull);
+      assert(Math.abs(contact.x - lastContact.x) < 2, "the contact anchor jumped at the rim");
+      assert(Math.max(...radii.map((r, index) => Math.abs(r - previous[index]))) < 3);
+      assert(Math.abs(material.state.signedHeight) < 0.05);
+      if (distance < boundary.radius) assert.equal(contact.x, raw.x, "inside input must remain exact");
+      if (distance > 104) assert.equal(material.contactDepth(), 0, "full pull must not retain a deep active dent");
+      previous = radii; lastContact = contact;
+    }
+  }
+  material.release(now); run(material, now, now + 6000);
+  assert.equal(material.state.active, false);
+  assert.equal(membraneRadiusAt(membraneRadii(material), -Math.PI / 4), 94);
+});
+
+test("a fixed pointer near the dented rim reaches equilibrium without pressure/pull feedback growth", () => {
+  for (const distance of [87, 91, 94, 98, 103]) {
+    const material = createMallangMaterial(); material.touch(180, 100, 0); run(material, 0, 1200);
+    const motion = { rect: { left: 0, top: 0, width: 800, height: 600 }, bodySize: 200,
+      position: { x: 50, y: 50 }, pointer: { x: 400 + distance, y: 300 } };
+    let previous, delta = 0;
+    for (let now = 1216; now <= 10000; now += 16) {
+      const raw = { x: 100 + distance, y: 100 }, boundary = materialContact(material, raw);
+      const pull = pulledCircle(motion, boundary.radius), contact = materialContact(material, raw, pull);
+      material.move(contact.x, contact.y, now, contact.pressure); material.advance(now);
+      const radii = membraneRadii(material, pull);
+      if (now > 8000) delta = Math.max(delta, Math.max(...radii.map((r, i) => Math.abs(r - previous[i]))));
+      previous = radii;
+    }
+    assert(delta < 0.01, `stationary contact at ${distance} kept oscillating: ${delta}`);
+  }
+});
+
+test("shell support keeps its local dwell response during a slow rim stroke", () => {
+  const material = createMallangMaterial(); material.setShell(createWaxShell(100, 94, 123));
+  material.touch(100, 100, 0); run(material, 0, 1200);
+  for (let frame = 1; frame <= 225; frame++) {
+    const now = 1200 + frame * 16;
+    material.move(100 + frame * 0.4, 100, now); material.advance(now);
+  }
+  assert(material.contactDepth() < 0.9, "a covered shell must not inherit sustained rim pressure");
+  assert(Math.abs(material.state.signedHeight) < 0.05);
+  material.release(4800); run(material, 4800, 11000);
+  assert.equal(material.state.active, false);
+});
